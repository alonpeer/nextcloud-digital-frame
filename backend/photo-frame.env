# Install to /etc/photo-frame.env, then:
#   sudo chown root:root /etc/photo-frame.env
#   sudo chmod 600 /etc/photo-frame.env
#
# systemd reads this as literal KEY=VALUE pairs. Do not quote values and do
# not put spaces around the '='.

# ---- Nextcloud -----------------------------------------------------------
NC_URL=
NC_USER_1=
# Generate at: Settings -> Personal -> Security -> "Create new app password".
# Use an app password, never your login password.
NC_PASS_1=

# Add additional accounts with NC_USER_2/NC_PASS_2 etc.

# ---- Frame behaviour -----------------------------------------------------
# Seconds each photo stays on screen.
PHOTO_INTERVAL=3600

# Seconds between checks for newly favourited photos. Hourly is plenty; the
# sync is cheap when nothing changed, since unchanged files are matched by
# ETag and never re-downloaded.
SYNC_INTERVAL=3600

# Longest edge, in pixels, after downscaling. The iPad Mini 1 screen is
# 1024x768 and non-retina, so 1400 already exceeds what it can display.
# Raising this costs RAM on the iPad, not quality you can see.
MAX_DIM=1400
JPEG_QUALITY=82

# ---- Quiet hours ---------------------------------------------------------
# The frame goes completely black between these times. 24-hour HH:MM. The
# window may cross midnight, which is the usual case.
#
# Leave both blank to disable.
#
# Note this blanks the picture, not the backlight: a web page cannot switch
# an iPad's screen off. Turn the brightness down if the dark grey still
# bothers you in a bedroom.
QUIET_START=23:00
QUIET_END=07:00

# ---- Server --------------------------------------------------------------
PORT=8080
BIND=0.0.0.0

# BASE_DIR is where the Python code and the www folder are.
BASE_DIR=/opt/photo-frame
